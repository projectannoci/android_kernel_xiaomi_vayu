+/* Manual 4.14 exec hook: use the new argv, not the previous process image. */
+int ksu_handle_init_exec(const char *filename, const char __user *argv1)
+{
+ char argument[32] = {0};
+ if (!ksu_execveat_hook || !filename || current_uid().val != 0)
+  return 0;
+ if (strcmp(filename, "/system/bin/init") && strcmp(filename, "/init") &&
+     !strstarts(filename, "/system/bin/app_process"))
+  return 0;
+ if (!IS_ERR_OR_NULL(argv1)) {
+  if (strncpy_from_user(argument, argv1, sizeof(argument) - 1) < 0)
+   return 0;
+ }
+ return ksu_handle_bprm_ksud(filename, argument, NULL, 0);
+}
