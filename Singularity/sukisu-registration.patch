-// Try read whitelist first, fallback if failed
+/* PackageManager's root-owned list is available on stock AOSP vendors too. */
+#define SYSTEM_PACKAGES_LIST_PATH "/data/system/packages.list"
+
+static int parse_package_uid_line(char *line, bool package_first, char *package, u32 *uid)
+{
+ char *first, *second, *name, *number;
+ line = skip_spaces(line);
+ first = strsep(&line, " \t\r");
+ if (!line || !*first)
+  return -EINVAL;
+ line = skip_spaces(line);
+ second = strsep(&line, " \t\r");
+ if (!second || !*second)
+  return -EINVAL;
+ name = package_first ? first : second;
+ number = package_first ? second : first;
+ if (strlen(name) >= KSU_MAX_PACKAGE_NAME)
+  return -ENAMETOOLONG;
+ if (kstrtou32(number, 10, uid))
+  return -EINVAL;
+ memcpy(package, name, strlen(name) + 1);
+ return 0;
+}
+
+static int read_uid_file(struct list_head *uid_list, const char *path, bool package_first)
+{
+ struct file *fp;
+ char *content, *line, *cursor;
+ loff_t size, pos = 0;
+ ssize_t count;
+ int found = 0;
+ fp = ksu_filp_open_compat(path, O_RDONLY, 0);
+ if (IS_ERR(fp))
+  return PTR_ERR(fp);
+ size = i_size_read(file_inode(fp));
+ if (size <= 0 || size > 4 * 1024 * 1024) {
+  filp_close(fp, NULL);
+  return -ENODATA;
+ }
+ content = kzalloc(size + 1, GFP_KERNEL);
+ if (!content) {
+  filp_close(fp, NULL);
+  return -ENOMEM;
+ }
+ count = ksu_kernel_read_compat(fp, content, size, &pos);
+ filp_close(fp, NULL);
+ if (count != size) {
+  kfree(content);
+  return -EIO;
+ }
+ cursor = content;
+ while ((line = strsep(&cursor, "\n"))) {
+  char package[KSU_MAX_PACKAGE_NAME];
+  u32 uid;
+  struct uid_data *entry;
+  if (parse_package_uid_line(line, package_first, package, &uid))
+   continue;
+  entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+  if (!entry) {
+   /* Discard a partial snapshot: never prune from incomplete input. */
+   struct uid_data *item, *next;
+   list_for_each_entry_safe(item, next, uid_list, list) {
+    list_del(&item->list);
+    kfree(item);
+   }
+   kfree(content);
+   return -ENOMEM;
+  }
+  entry->uid = uid;
+  memcpy(entry->package, package, strlen(package) + 1);
+  list_add_tail(&entry->list, uid_list);
+  found++;
+ }
+ kfree(content);
+ return found ? 0 : -ENODATA;
+}
